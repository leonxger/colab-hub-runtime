+#include <cstdlib>
+
+// rows of the LM head a DFlash2 draft scores (LLAMA_DFLASH_DRAFT_VOCAB, 0 = all); token ids are a prefix, lowest ids first
+static int64_t dflash2_draft_vocab() {
+    static const int64_t n = [] {
+        const char * env = getenv("LLAMA_DFLASH_DRAFT_VOCAB");
+        return env ? std::max<int64_t>(0, atoll(env)) : 0;
+    }();
+    return n;
+}
